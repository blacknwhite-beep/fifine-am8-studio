<Window x:Class="FifineAM8Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIFINE AM8 Studio — Software DSP Control"
        Width="1120" Height="730" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="24" CornerRadius="4" Background="{StaticResource AccentPurple}" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="FIFINE AM8" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="STUDIO DSP SUITE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBright}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Device Status Card -->
                    <Border Background="#181B26" BorderBrush="#292D3E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusLabel" Text="Live (48 kHz)" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                            <TextBlock Text="VID_3142 · PID_A010" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="GateBadge" Text="Gate: Open" FontSize="11" Foreground="#A78BFA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Quick Actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="QuickMuteBtn" Content="MIC LIVE (Click to Mute)" Height="38"
                            Background="#23273A" Foreground="White" BorderBrush="#353A52" BorderThickness="1"
                            FontWeight="SemiBold" Cursor="Hand" Click="QuickMuteBtn_Click" Margin="0,0,0,8"/>
                    <Button x:Name="ResetAllBtn" Content="Reset All to Default" Height="32"
                            Style="{StaticResource PresetBtn}" Margin="0" Click="ResetAllBtn_Click"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Margin="0,8,0,0">
                    <RadioButton x:Name="NavConfig" Content="  Configuration &amp; FX" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Changed"/>
                    <RadioButton x:Name="NavEq" Content="  10-Band EQ &amp; Presets" Style="{StaticResource NavButton}" Checked="Nav_Changed"/>
                    <RadioButton x:Name="NavRouting" Content="  Audio Routing" Style="{StaticResource NavButton}" Checked="Nav_Changed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP LIVE WAVEFORM & METER BAR -->
            <Border Grid.Row="0" Style="{StaticResource GenieCard}" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input Level -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <DockPanel>
                            <TextBlock Text="RAW MIC INPUT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="InputDbText" Text="-60 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="#252836" Margin="0,6,0,0" ClipToBounds="True">
                            <Border x:Name="InputMeterFill" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- Live Waveform -->
                    <Border Grid.Column="1" Background="#11131B" BorderBrush="#232635" BorderThickness="1" CornerRadius="8" Height="44" ClipToBounds="True">
                        <Canvas x:Name="WaveformCanvas"/>
                    </Border>

                    <!-- Output Level -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <DockPanel>
                            <TextBlock Text="PROCESSED OUTPUT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="OutputDbText" Text="-60 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBright}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="#252836" Margin="0,6,0,0" ClipToBounds="True">
                            <Border x:Name="OutputMeterFill" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="{StaticResource AccentPurple}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TAB 1: CONFIGURATION & FX -->
            <ScrollViewer Grid.Row="1" x:Name="PanelConfig" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Switches & Dynamics -->
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource GenieCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="MICROPHONE CONTROLS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="Noise Reduction / Smart Gate" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Suppresses keyboard, fan &amp; room hum between words" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleNoiseReduction" Style="{StaticResource GenieToggle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>

                                <DockPanel Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Low-Cut Filter (80 Hz)" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Removes desk bumps, AC rumble &amp; plosives" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleLowCut" Style="{StaticResource GenieToggle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>

                                <DockPanel Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Mid-Freq Presence Boost" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="+3.5 dB vocal clarity lift around 3.2 kHz" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TogglePresence" Style="{StaticResource GenieToggle}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>

                                <DockPanel Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Studio Compressor &amp; Limiter" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Evens out quiet &amp; loud speech without clipping" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleCompressor" Style="{StaticResource GenieToggle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>

                                <DockPanel Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="10-Band Parametric EQ" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Applies your active EQ curve &amp; preset" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleEq" Style="{StaticResource GenieToggle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Voice FX Card -->
                        <Border Style="{StaticResource GenieCard}">
                            <StackPanel>
                                <TextBlock Text="VOICE CHANGER / FX" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton x:Name="FxDefault" Content="Default (Clean)" Style="{StaticResource NavButton}" GroupName="VoiceFx" IsChecked="True" Checked="ParamChanged" Margin="0,0,8,6"/>
                                    <RadioButton x:Name="FxMonster" Content="Monster" Style="{StaticResource NavButton}" GroupName="VoiceFx" Checked="ParamChanged" Margin="0,0,8,6"/>
                                    <RadioButton x:Name="FxRobot" Content="Robot" Style="{StaticResource NavButton}" GroupName="VoiceFx" Checked="ParamChanged" Margin="0,0,8,6"/>
                                    <RadioButton x:Name="FxMegaphone" Content="Megaphone" Style="{StaticResource NavButton}" GroupName="VoiceFx" Checked="ParamChanged" Margin="0,0,8,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Gain, Gate, Comp, Reverb, Monitor Sliders -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource GenieCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="LEVELS &amp; DYNAMICS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" Margin="0,0,0,12"/>

                                <!-- Mic Gain -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Microphone Gain" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GainValText" Text="0.0 dB" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderGain" Minimum="-24" Maximum="24" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,2,0,12"/>

                                <!-- Gate Threshold -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Noise Gate Threshold" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GateValText" Text="-46 dB" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderGate" Minimum="-65" Maximum="-15" Value="-46" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,2,0,12"/>

                                <!-- Compressor -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Compressor Strength" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CompValText" Text="45%" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderComp" Minimum="0" Maximum="100" Value="45" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,2,0,12"/>

                                <!-- Brickwall peak limiter -->
                                <DockPanel Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Peak Limiter (Transient Guard)" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Catches desk slams &amp; plosives before they clip" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleLimiter" Style="{StaticResource GenieToggle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,2">
                                    <TextBlock Text="Limiter Ceiling" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="LimiterValText" Text="-3.0 dB" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderLimiter" Minimum="-12" Maximum="-0.5" Value="-3" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,2,0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Reverb & Live Monitor -->
                        <Border Style="{StaticResource GenieCard}">
                            <StackPanel>
                                <TextBlock Text="REVERB &amp; LIVE MONITORING" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Studio Room Reverb" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ToggleReverb" Style="{StaticResource GenieToggle}" IsChecked="False" HorizontalAlignment="Right" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,2">
                                    <TextBlock Text="Reverb Mix" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="ReverbValText" Text="22%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderReverb" Minimum="0" Maximum="85" Value="22" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,0,0,14"/>

                                <DockPanel Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Real-Time Headphone Monitor" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Hear your processed voice live in headphones" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleMonitor" Style="{StaticResource GenieToggle}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ParamChanged" Unchecked="ParamChanged"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,2">
                                    <TextBlock Text="Monitor Volume" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="MonitorValText" Text="75%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderMonitor" Minimum="0" Maximum="100" Value="75" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- TAB 2: 10-BAND PARAMETRIC EQ -->
            <Grid Grid.Row="1" x:Name="PanelEq" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FIFINE Genie Presets Bar -->
                <Border Grid.Row="0" Style="{StaticResource GenieCard}" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="FIFINE PRESETS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Content="Flat" Style="{StaticResource PresetBtn}" Click="Preset_Click" Tag="Flat" Margin="0,0,8,0"/>
                            <Button Content="Broadcast" Style="{StaticResource PresetBtn}" Click="Preset_Click" Tag="Broadcast" Margin="0,0,8,0"/>
                            <Button Content="Clarity" Style="{StaticResource PresetBtn}" Click="Preset_Click" Tag="Clarity" Margin="0,0,8,0"/>
                            <Button Content="Deep Voice" Style="{StaticResource PresetBtn}" Click="Preset_Click" Tag="DeepVoice" Margin="0,0,8,0"/>
                            <Button Content="Less Nasal" Style="{StaticResource PresetBtn}" Click="Preset_Click" Tag="LessNasal" Margin="0,0,8,0"/>
                            <Button Content="Walkie Talkie" Style="{StaticResource PresetBtn}" Click="Preset_Click" Tag="WalkieTalkie" Margin="0"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- Interactive EQ Curve Canvas -->
                <Border Grid.Row="1" Style="{StaticResource GenieCard}" Padding="12" Margin="0,0,0,12">
                    <Canvas x:Name="EqCanvas" Background="#11131B" ClipToBounds="True" SizeChanged="EqCanvas_SizeChanged"/>
                </Border>

                <!-- 10 Vertical Band Sliders -->
                <Border Grid.Row="2" Style="{StaticResource GenieCard}" Padding="14,12">
                    <UniformGrid x:Name="EqSlidersGrid" Rows="1" Columns="10"/>
                </Border>
            </Grid>

            <!-- TAB 3: AUDIO ROUTING -->
            <ScrollViewer Grid.Row="1" x:Name="PanelRouting" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource GenieCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="AUDIO DEVICE ROUTING" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBright}" VerticalAlignment="Center"/>
                            <Button Content="Refresh Devices" Style="{StaticResource PresetBtn}" HorizontalAlignment="Right" Margin="0" Click="RefreshDevices_Click"/>
                        </DockPanel>

                        <TextBlock Text="1. Microphone Input (Raw AM8)" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,4"/>
                        <ComboBox x:Name="ComboInput" Height="34" Margin="0,0,0,14" SelectionChanged="DeviceCombo_Changed"/>

                        <TextBlock Text="2. Virtual Mic Output (Feeds Discord / OBS / Games)" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <ComboBox x:Name="ComboVirtualOut" Height="34" Margin="0,0,0,14" SelectionChanged="DeviceCombo_Changed"/>

                        <TextBlock Text="3. Headphone Monitor Output (Optional Live Sidetone)" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <ComboBox x:Name="ComboMonitorOut" Height="34" Margin="0,0,0,18" SelectionChanged="DeviceCombo_Changed"/>

                        <Border Background="#1D1730" BorderBrush="#9147FF" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="How to use in Discord, OBS, or Windows Games:" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#D1D5DB" Margin="0,6,0,0"
                                           Text="Keep your raw mic selected as 'Microphone (fifine Microphone)' in slot 1 and 'fifine - Microphone (fifine Virtual Audio Device)' in slot 2. Then in Discord / OBS / Windows Sound Input, select 'fifine - Microphone (fifine Virtual Audio Device)' — every EQ, Gate, Compressor, Reverb, and Voice FX change here will be heard live!"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
